<?xml version="1.0"?>
<!--
  litegrip.ros2_control.xacro — the ros2_control hardware interface declaration
  for the LiteGrip gripper.

  This file is a declaration only: no kinematics and no geometry. The gripper's
  link / joint / mimic come from the description package
  (litearm_manipulation/urdf/litearm_gripper.urdf.xacro; the geometry comes from
  the litegrip description package). Usage:

      <xacro:include filename="$(find litegrip_ros2_control)/urdf/litegrip.ros2_control.xacro"/>

  ★ Why a <plugin> rather than a "bundled node + topics"
  ══════════════════════════════════════════════════════
  The gripper thereby becomes a ros2_control **hardware component**: it is
  loaded / activated / deactivated by controller_manager together with the arm,
  its joint shows up in /joint_states, and controllers (JTC / forward) claim its
  position interface directly. So the layer above no longer has to invent a
  topic protocol of its own plus a bridging node of its own — this is the same
  road the arm takes, with only one mental model to carry.

  ★ Interface surface (decided by the user on 2026-09-23)
  ═══════════════════════════════════════════════════════
    command: position only (DM MIT position control underneath, the same
             protocol family as the other joints)
    state:   position / velocity / effort (matching the other joints' trio)

  The trajectory advance rate ceiling and the torque budget are **not** command
  interfaces but daemon parameters (see config/litegrip_hw.yaml): they describe
  "how this gripper is allowed to move" and belong to the deployment
  configuration, so they must not be decided by each command publisher on its
  own.

  ⚠ Conversion parameters (closed_rad / rad_to_mm / red line)
  ═══════════════════════════════════════════════════════════════
  Their source and the consistency rule: they come from
  sdk/litegrip/physical_calibration.json and the safety baseline JSON; the
  values here are **copies** (same source, same values as litearm_manipulation's
  manipulation.yaml). The single source of truth is still those two JSON files —
  after a recalibration this file must be kept in sync, and the consistency is
  checked by test/test_gripper_motor_scale.py recomputing against the SDK (it
  goes red on a mismatch).
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Shared memory segment name: must match the daemon's shm_name parameter -->
  <xacro:arg name="litegrip_shm_name" default="/litegrip_hw"/>

  <!-- Calibration (physical_calibration.json): the motor angle at opening = 0,
       and how many mm one rad is -->
  <xacro:arg name="litegrip_closed_rad" default="0.04139"/>
  <xacro:arg name="litegrip_rad_to_mm" default="65.0231"/>

  <!-- Safety red line (safety_limits_350.json, safety baseline 3.5). The more
       negative the value, the wider the opening.
       ⚠ This is the basis of the "commandable range": the model layer's
         0~87 mm is wider than the ≈3.34~83.32 mm the red line allows, and the
         plugin clamps the target into the commandable range before publishing —
         without clamping, "fully open 87 mm" would be rejected wholesale by the
         daemon (symptom: the gripper does not move at all, it only leaves a 1
         behind in fault_code). -->
  <xacro:arg name="litegrip_red_open_rad" default="-1.24"/>
  <xacro:arg name="litegrip_red_close_rad" default="-0.01"/>

  <!-- Model-layer opening range (m), matching the joint limits in
       litearm_gripper.urdf.xacro -->
  <xacro:arg name="litegrip_min_width" default="0.0"/>
  <xacro:arg name="litegrip_max_width" default="0.087"/>

  <!-- Timeout for waiting for the daemon to become ready (seconds). Whether the
       segment does not exist or the daemon has not connected to the gripper, it
       errors out here, and the message carries actionable troubleshooting
       hints. -->
  <xacro:arg name="litegrip_connect_timeout_s" default="10.0"/>
  <!-- Daemon heartbeat timeout (seconds). Past it the daemon is presumed dead:
       the state freezes and an error is logged. -->
  <xacro:arg name="litegrip_heartbeat_timeout_s" default="1.0"/>
  <!-- Export the diagnostic state interfaces (temperature / error_code /
       fault_code / feedback age). They are not part of the standard trio and
       joint_state_broadcaster will not claim them; on activation the CM warns
       that "these interfaces are unclaimed" — that is expected, so set false if
       it is too noisy. -->
  <xacro:arg name="litegrip_export_diagnostics" default="true"/>

  <ros2_control name="LitegripSystem" type="system">
    <hardware>
      <!-- ★ Loaded as a plugin: this is where "as a hardware_interface" lands -->
      <plugin>litegrip_ros2_control/LitegripSystem</plugin>

      <param name="shm_name">$(arg litegrip_shm_name)</param>
      <param name="closed_rad">$(arg litegrip_closed_rad)</param>
      <param name="rad_to_mm">$(arg litegrip_rad_to_mm)</param>
      <param name="red_open_rad">$(arg litegrip_red_open_rad)</param>
      <param name="red_close_rad">$(arg litegrip_red_close_rad)</param>
      <param name="min_width">$(arg litegrip_min_width)</param>
      <param name="max_width">$(arg litegrip_max_width)</param>
      <param name="connect_timeout_s">$(arg litegrip_connect_timeout_s)</param>
      <param name="heartbeat_timeout_s">$(arg litegrip_heartbeat_timeout_s)</param>
      <param name="export_diagnostics">$(arg litegrip_export_diagnostics)</param>
    </hardware>

    <!-- ★ The master joint. The two fingers (gripper_slide_joint_left/right) are
         its <mimic>, have no independent command port, and therefore do **not
         appear** here — a real gripper has only one transmission. The joint
         name must match urdf/litearm_gripper.urdf.xacro. -->
    <joint name="gripper_opening_joint">
      <!-- Only position is exposed for command: MIT position control underneath,
           the same as the other joints -->
      <command_interface name="position"/>
      <!-- Feedback like any other joint: position / velocity / torque -->
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <state_interface name="temperature_mos"/>
      <state_interface name="temperature_coil"/>
      <state_interface name="error_code"/>
      <state_interface name="fault_code"/>
      <state_interface name="feedback_age"/>
    </joint>
  </ros2_control>

</robot>
